# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values before running `docker compose up --build`.
# NEVER commit the real .env file — it belongs in .gitignore.

# MySQL root password. Also used by every backend service to connect.
DB_ROOT_PASSWORD=change_me_to_a_strong_password

# JWT signing secret shared by every service. Generate a fresh one, e.g.:
#   openssl rand -hex 32
# Do NOT reuse the demo secret that was hardcoded in this repo's schema.txt —
# treat that value as already-leaked and never use it anywhere real.
JWT_SECRET=change_me_to_a_long_random_hex_string

# Public URL the app will actually be served from (used for the gateway's
# CORS allow-list; only relevant if something calls api-gateway directly
# instead of going through the frontend's nginx proxy).
PUBLIC_APP_URL=http://localhost:8090

# Hibernate DDL strategy. "update" auto-creates/updates tables on boot, fine
# for a first deploy or a demo. For an ongoing production system, manage the
# schema with a real migration tool (e.g. Flyway) and set this to "validate".
JPA_DDL_AUTO=update
